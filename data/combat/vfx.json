		"earth": "#e0552e"
	},

	"_skill_comment": "SKILL TREE hits (client/stage_view.gd): 'skill_hit/<tier 1-3>' sparks on every struck target, 'skill_hit/crit' on crits, 'skill_hit/tick' for periodic ground/totem hits, 'skill_dot' for burn/bleed ticks, 'skill_impact/<tier>'  'skill_impact/crit' = camera only (shake/punch/flash), played once per frame and only when the local player cast or took the hit. The tier comes from the rules (data/skill_system/integration.json 'impact'). 'skill_gem/<effect gem id>' plays on the target when a hit carries that effect gem (thorns/regen play on the caster at cast). 'weapon' color in skill keys = skill_colors[skill].",
	"skill_colors": {
		"storm_blades": "crimson", "blood_pierce": "crimson", "thorn_trap": "crimson", "blood_shield": "crimson",
		"fire_ring": "ember", "fireball": "ember", "eruption": "fire", "flame_dash": "ember",
