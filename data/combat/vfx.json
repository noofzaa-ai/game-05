		"chain_lightning": "lightning", "lightning_strike": "lightning", "blink_bolt": "lightning", "tesla_totem": "lightning",
		"ground_slam": "earth", "riposte": "gold", "piercing_shot": "gold", "war_cry": "stun"
	},

