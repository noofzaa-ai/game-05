FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY server ./server
COPY assets ./assets
COPY admin ./admin
COPY index.html config.js trail.js auth.js styles.css ./
USER node
EXPOSE 4173
CMD ["node", "server/index.mjs"]
