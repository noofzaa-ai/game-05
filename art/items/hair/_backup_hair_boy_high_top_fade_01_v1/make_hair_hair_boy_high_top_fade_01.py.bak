from __future__ import annotations

import json
import math
import os
import sys
from mathutils import Vector

import bmesh
import bpy

PROJECT_ROOT = "/Users/user/godot-project/test01"
REFERENCE_GLB = os.path.join(PROJECT_ROOT, "art/characters/chibi-studio/hair_head_reference.glb")
OUTPUT_DIR = os.path.join(PROJECT_ROOT, "art/characters/chibi-studio/hair")
ASSET_ID = "hair_boy_high_top_fade_01"
DISPLAY_NAME = "เด็กผู้ชาย · ไฮท็อปเฟด 01"
OUTPUT_GLB = os.path.join(OUTPUT_DIR, ASSET_ID + ".glb")
OUTPUT_JSON = os.path.join(OUTPUT_DIR, ASSET_ID + ".json")
PREVIEW_PREFIX = os.path.join(OUTPUT_DIR, "preview_" + ASSET_ID + "_")
VIEWS = ("front", "side", "back", "top")


def fail(message: str) -> None:
    raise RuntimeError(message)


def identity(obj: bpy.types.Object) -> bool:
    return (obj.location.length <= 1e-4 and all(abs(v) <= 1e-4 for v in obj.rotation_euler)
            and all(abs(v - 1.0) <= 1e-4 for v in obj.scale))


def reset() -> None:
    bpy.ops.wm.read_factory_settings(use_empty=True)
    scene = bpy.context.scene
    scene.unit_settings.system = "METRIC"
    scene.unit_settings.scale_length = 1.0
    scene.unit_settings.length_unit = "METERS"
    os.makedirs(OUTPUT_DIR, exist_ok=True)
    if not os.path.isfile(REFERENCE_GLB):
        fail("Missing reference GLB: " + REFERENCE_GLB)


def import_reference() -> list[bpy.types.Object]:
    before = set(bpy.context.scene.objects)
    bpy.ops.import_scene.gltf(filepath=REFERENCE_GLB)
    imported = [o for o in bpy.context.scene.objects if o not in before]
    marker = bpy.data.objects.get("hair_attach")
    if marker is None or marker not in imported or not identity(marker):
        fail("Reference hair_attach marker is missing or non-identity")
    bpy.data.objects.remove(marker, do_unlink=True)
    ref_root = bpy.data.objects.get("HairRoot")
    if ref_root is not None:
        ref_root.name = "ReferenceRoot"
    return [o for o in imported if o != marker]


def material(name: str, color: tuple[float, float, float, float]) -> bpy.types.Material:
    mat = bpy.data.materials.new(name)
    mat.use_nodes = True
    mat.diffuse_color = color
    mat.use_backface_culling = True
    shader = mat.node_tree.nodes.get("Principled BSDF")
    if shader is None:
        fail("Principled BSDF unavailable")
    shader.inputs["Base Color"].default_value = color
    shader.inputs["Metallic"].default_value = 0.0
    shader.inputs["Roughness"].default_value = 0.82
    return mat


def recalc(mesh: bpy.types.Mesh) -> None:
    mesh.validate(verbose=False)
    mesh.update(calc_edges=True)
    bm = bmesh.new()
    bm.from_mesh(mesh)
    bmesh.ops.recalc_face_normals(bm, faces=bm.faces)
    bm.to_mesh(mesh)
    bm.free()
    mesh.update(calc_edges=True)
    for p in mesh.polygons:
        p.use_smooth = False


def mesh_obj(name: str, verts: list[tuple[float, float, float]], faces: list[tuple[int, ...]], root: bpy.types.Object, mat: bpy.types.Material) -> bpy.types.Object:
    mesh = bpy.data.meshes.new(name + " Mesh")
    mesh.from_pydata(verts, [], faces)
    recalc(mesh)
    obj = bpy.data.objects.new(name, mesh)
    bpy.context.collection.objects.link(obj)
    obj.parent = root
    obj.location = (0.0, 0.0, 0.0)
    obj.rotation_euler = (0.0, 0.0, 0.0)
    obj.scale = (1.0, 1.0, 1.0)
    obj.data.materials.append(mat)
    obj["asset_type"] = "hair_mesh"
    obj["faceted"] = True
    return obj


def rounded_rect(x: float, front: float, back: float, bevel: float, z: float) -> list[tuple[float, float, float]]:
    return [(-x + bevel, front, z), (x - bevel, front, z), (x, front + bevel, z),
            (x, back - bevel, z), (x - bevel, back, z), (-x + bevel, back, z),
            (-x, back - bevel, z), (-x, front + bevel, z)]


def closed_loft(name: str, rings: list[tuple[float, float, float, float, float]], root: bpy.types.Object, mat: bpy.types.Material) -> bpy.types.Object:
    verts: list[tuple[float, float, float]] = []
    for z, x, front, back, bevel in rings:
        verts.extend(rounded_rect(x, front, back, bevel, z))
    n = 8
    faces: list[tuple[int, ...]] = [tuple(reversed(range(n)))]
    for row in range(len(rings) - 1):
        for i in range(n):
            j = (i + 1) % n
            a, b = row * n + i, row * n + j
            faces.append((a, b, b + n, a + n))
    last = (len(rings) - 1) * n
    faces.append(tuple(last + i for i in range(n)))
    return mesh_obj(name, verts, faces, root, mat)


def closed_box(name: str, bounds: tuple[float, float, float, float, float, float], root: bpy.types.Object, mat: bpy.types.Material) -> bpy.types.Object:
    x0, x1, y0, y1, z0, z1 = bounds
    v = [(x0, y0, z0), (x1, y0, z0), (x1, y1, z0), (x0, y1, z0),
         (x0, y0, z1), (x1, y0, z1), (x1, y1, z1), (x0, y1, z1)]
    f = [(0, 3, 2, 1), (4, 5, 6, 7), (0, 1, 5, 4), (1, 2, 6, 5),
         (2, 3, 7, 6), (3, 0, 4, 7)]
    return mesh_obj(name, v, f, root, mat)


def closed_wedge(name: str, x0: float, x1: float, y0: float, y1: float, z0: float, z1: float, root: bpy.types.Object, mat: bpy.types.Material) -> bpy.types.Object:
    # A tapered, sealed top facet; it intersects the main tower at its lower edge.
    v = [(x0, y0, z0), (x1, y0, z0), (x1, y1, z0), (x0, y1, z0),
         (x0 * 0.86, y0 + 0.008, z1), (x1 * 0.86, y0 + 0.008, z1),
         (x1 * 0.86, y1 - 0.008, z1), (x0 * 0.86, y1 - 0.008, z1)]
    f = [(0, 3, 2, 1), (4, 5, 6, 7), (0, 1, 5, 4), (1, 2, 6, 5),
         (2, 3, 7, 6), (3, 0, 4, 7)]
    return mesh_obj(name, v, f, root, mat)


def create_asset() -> tuple[bpy.types.Object, list[bpy.types.Object]]:
    root = bpy.data.objects.new("HairRoot", None)
    bpy.context.collection.objects.link(root)
    root.location = (0.0, 0.0, 0.0)
    root.rotation_euler = (0.0, 0.0, 0.0)
    root.scale = (1.0, 1.0, 1.0)
    for key, value in {
        "asset_type": "hair", "spec_version": "1.0", "id": ASSET_ID,
        "display_name": DISPLAY_NAME, "fit_profile": "chibi-sculpt-v1",
        "target_socket": "attach_head", "units": "meters", "up_axis": "+Y",
        "forward_axis": "+Z", "attachment_mode": "rigid",
    }.items():
        root[key] = value
    marker = bpy.data.objects.new("hair_attach", None)
    bpy.context.collection.objects.link(marker)
    marker.parent = root
    marker.location = (0.0, 0.0, 0.0)
    marker.rotation_euler = (0.0, 0.0, 0.0)
    marker.scale = (1.0, 1.0, 1.0)
    marker["marker_type"] = "hair_attach"
    hair = material("High top midnight blue", (0.018, 0.055, 0.16, 1.0))
    pieces: list[bpy.types.Object] = []
    pieces.append(closed_loft("HighTop_Cap", [
        (-0.055, 0.164, -0.158, 0.142, 0.025),
        (-0.010, 0.164, -0.154, 0.140, 0.025),
        (0.050, 0.160, -0.145, 0.132, 0.024),
        (0.135, 0.153, -0.132, 0.122, 0.022),
        (0.215, 0.145, -0.119, 0.112, 0.020),
        (0.245, 0.139, -0.114, 0.108, 0.019),
        (0.270, 0.132, -0.108, 0.103, 0.018),
    ], root, hair))
    # Two visibly stepped levels replace a painted fade on each temple and at the nape.
    for side, sign in (("L", -1.0), ("R", 1.0)):
        pieces.append(closed_box("HighTop_Fade1_Side_" + side,
                                 (min(sign * 0.171, sign * 0.143), max(sign * 0.171, sign * 0.143), -0.112, 0.126, -0.205, -0.130), root, hair))
        pieces.append(closed_box("HighTop_Fade2_Side_" + side,
                                 (min(sign * 0.171, sign * 0.146), max(sign * 0.171, sign * 0.146), -0.125, 0.130, -0.135, -0.042), root, hair))
    pieces.append(closed_box("HighTop_Fade1_Nape", (-0.132, 0.132, 0.132, 0.171, -0.205, -0.130), root, hair))
    pieces.append(closed_box("HighTop_Fade2_Nape", (-0.145, 0.145, 0.125, 0.166, -0.135, -0.042), root, hair))
    # Small sealed facets make the tall, squared crown read as block-built rather than a dome.
    pieces.append(closed_wedge("HighTop_CrownFacet_L", -0.112, -0.012, -0.105, 0.095, 0.208, 0.282, root, hair))
    pieces.append(closed_wedge("HighTop_CrownFacet_R", 0.012, 0.112, -0.105, 0.095, 0.208, 0.282, root, hair))
    for obj in pieces:
        bpy.context.view_layer.objects.active = obj
        obj.select_set(True)
        bpy.ops.object.transform_apply(location=False, rotation=True, scale=True)
        obj.select_set(False)
    return root, pieces


def descendants(root: bpy.types.Object) -> list[bpy.types.Object]:
    result: list[bpy.types.Object] = []
    stack = list(root.children)
    while stack:
        obj = stack.pop()
        result.append(obj)
        stack.extend(obj.children)
    return result


def triangles(objects: list[bpy.types.Object]) -> int:
    total = 0
    for obj in objects:
        if obj.type == "MESH":
            obj.data.calc_loop_triangles()
            total += len(obj.data.loop_triangles)
    return total


def assert_closed(objects: list[bpy.types.Object]) -> None:
    for obj in objects:
        if obj.type != "MESH":
            continue
        bm = bmesh.new()
        bm.from_mesh(obj.data)
        boundary = [e for e in bm.edges if len(e.link_faces) != 2]
        bm.free()
        if boundary:
            fail("Open mesh %s: %d boundary edges" % (obj.name, len(boundary)))


def export(root: bpy.types.Object) -> None:
    bpy.ops.object.select_all(action="DESELECT")
    root.select_set(True)
    for child in descendants(root):
        child.select_set(True)
    bpy.context.view_layer.objects.active = root
    bpy.ops.export_scene.gltf(filepath=OUTPUT_GLB, export_format="GLB", use_selection=True,
                              export_apply=True, export_yup=True, export_animations=False,
                              export_cameras=False, export_lights=False, export_materials="EXPORT",
                              export_extras=True)
    if not os.path.isfile(OUTPUT_GLB) or os.path.getsize(OUTPUT_GLB) == 0:
        fail("GLB export failed")


def rename_source_away(root: bpy.types.Object) -> None:
    for obj in [root] + descendants(root):
        obj.name = "__source_" + obj.name


def bbox(objects: list[bpy.types.Object]) -> tuple[tuple[float, ...], tuple[float, ...]]:
    points = [obj.matrix_world @ v.co for obj in objects if obj.type == "MESH" for v in obj.data.vertices]
    if not points:
        fail("No mesh vertices")
    return tuple(min(p[i] for p in points) for i in range(3)), tuple(max(p[i] for p in points) for i in range(3))


def reimport(expected: int) -> dict:
    before = set(bpy.context.scene.objects)
    bpy.ops.import_scene.gltf(filepath=OUTPUT_GLB)
    imported = [o for o in bpy.context.scene.objects if o not in before]
    roots = [o for o in imported if o.name == "HairRoot"]
    if len(roots) != 1:
        fail("Expected one HairRoot after re-import: " + str([o.name for o in imported]))
    root = roots[0]
    desc = descendants(root)
    meshes = [o for o in desc if o.type == "MESH"]
    markers = [o for o in desc if o.name == "hair_attach"]
    if len(markers) != 1 or not identity(root) or not identity(markers[0]):
        fail("Root/marker identity or name check failed")
    for o in imported:
        if o.type in {"CAMERA", "LIGHT", "ARMATURE", "CURVE"}:
            fail("Forbidden exported object: " + o.type)
    for o in meshes:
        if not identity(o):
            fail("Mesh transform not applied: " + o.name)
        for slot in o.material_slots:
            if slot.material is not None and not slot.material.use_backface_culling:
                fail("Double-sided material: " + slot.material.name)
    actual = triangles(meshes)
    if actual != expected:
        fail("Triangle count changed: %d vs %d" % (actual, expected))
    mins, maxs = bbox(meshes)
    if mins[1] < -0.44:
        fail("Minimum re-import Y is below -0.44: %.6f" % mins[1])
    if any(not math.isfinite(v) for v in mins + maxs):
        fail("Non-finite bounding box")
    return {
        "root_name": root.name, "marker_name": markers[0].name,
        "mesh_names": [o.name for o in meshes], "triangle_count": actual,
        "bounding_box_blender_import": {"min": [round(v, 6) for v in mins], "max": [round(v, 6) for v in maxs], "minimum_y": round(mins[1], 6)},
        "object_types": sorted({o.type for o in imported}), "forbidden_objects_present": False,
        "materials": [{"name": slot.material.name, "double_sided": not slot.material.use_backface_culling,
                       "metallic": round(slot.material.node_tree.nodes["Principled BSDF"].inputs["Metallic"].default_value, 4),
                       "roughness": round(slot.material.node_tree.nodes["Principled BSDF"].inputs["Roughness"].default_value, 4)}
                      for o in meshes for slot in o.material_slots if slot.material is not None],
        "external_images": [],
    }


def look_at(obj: bpy.types.Object, target: Vector) -> None:
    obj.rotation_euler = (target - obj.location).to_track_quat("-Z", "Y").to_euler()


def previews(reference: list[bpy.types.Object]) -> None:
    scene = bpy.context.scene
    scene.render.engine = "BLENDER_EEVEE"
    scene.render.resolution_x = scene.render.resolution_y = 512
    scene.render.resolution_percentage = 100
    scene.render.image_settings.file_format = "PNG"
    scene.render.film_transparent = False
    scene.view_settings.view_transform = "AgX"
    scene.view_settings.look = "AgX - Medium High Contrast"
    scene.view_settings.exposure = -1.0
    scene.world = bpy.data.worlds.new("High Top Preview World")
    scene.world.color = (0.015, 0.015, 0.02)
    cam_data = bpy.data.cameras.new("Preview Camera")
    cam = bpy.data.objects.new("Preview Camera", cam_data)
    bpy.context.collection.objects.link(cam)
    scene.camera = cam
    cam.data.lens = 58
    def light(name: str, loc: tuple[float, float, float], energy: float, size: float) -> None:
        data = bpy.data.lights.new(name, "AREA")
        data.energy, data.shape, data.size = energy, "DISK", size
        obj = bpy.data.objects.new(name, data)
        bpy.context.collection.objects.link(obj)
        obj.location = loc
        look_at(obj, Vector((0.0, 0.0, 0.04)))
    light("Key", (-0.55, -0.65, 0.55), 25.0, 0.55)
    light("Fill", (0.60, -0.35, 0.10), 8.0, 0.45)
    light("Rim", (0.15, 0.55, 0.45), 16.0, 0.50)
    target = Vector((0.0, 0.0, 0.02))
    specs = {"front": ((0.0, -0.95, 0.02), 58), "side": ((0.95, 0.02, 0.02), 58),
             "back": ((0.0, 0.95, 0.02), 58), "top": ((0.0, -0.02, 0.95), 62)}
    for view, (loc, lens) in specs.items():
        cam.location = loc
        cam.data.lens = lens
        look_at(cam, target)
        scene.render.filepath = PREVIEW_PREFIX + view + ".png"
        bpy.ops.render.render(write_still=True)


def write_json(tri: int, report: dict) -> None:
    data = {"asset_type": "hair", "spec_version": "1.0", "id": ASSET_ID, "display_name": DISPLAY_NAME,
            "fit_profile": "chibi-sculpt-v1", "target_socket": "attach_head", "units": "meters",
            "up_axis": "+Y", "forward_axis": "+Z", "attachment_mode": "rigid", "style": "90s high top fade",
            "geometry": {"triangle_count": tri, "budget": "200-800 triangles", "faceted": True,
                         "closed_meshes": True, "mesh_names": report["mesh_names"]},
            "material": {"name": "High top midnight blue", "base_color_linear_rgba": [0.018, 0.055, 0.16, 1.0],
                         "double_sided": False, "metallic": 0.0, "roughness": 0.82, "textures": []},
            "validation": {"reference_head_used_without_transform": True, "reimport": report,
                           "preview_color_management": {"view_transform": "AgX", "look": "AgX - Medium High Contrast", "exposure": -1.0},
                           "preview_views": [PREVIEW_PREFIX + v + ".png" for v in VIEWS]}}
    with open(OUTPUT_JSON, "w", encoding="utf-8") as handle:
        json.dump(data, handle, ensure_ascii=False, indent=2)
        handle.write("\n")


def main() -> None:
    reset()
    reference = import_reference()
    root, pieces = create_asset()
    assert_closed(pieces)
    tri = triangles(pieces)
    if not 200 <= tri <= 800:
        fail("Triangle budget violation: %d" % tri)
    export(root)
    rename_source_away(root)
    report = reimport(tri)
    previews(reference)
    for view in VIEWS:
        path = PREVIEW_PREFIX + view + ".png"
        if not os.path.isfile(path) or os.path.getsize(path) == 0:
            fail("Missing preview: " + path)
    write_json(tri, report)
    print("HIGH_TOP_BUILD_OK")
    print("GLB:", OUTPUT_GLB)
    print("JSON:", OUTPUT_JSON)
    print("TRIANGLES:", tri)
    print("REIMPORT:", json.dumps(report, ensure_ascii=False, sort_keys=True))
    print("PREVIEWS:", ", ".join(PREVIEW_PREFIX + v + ".png" for v in VIEWS))


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print("HIGH_TOP_BUILD_FAILED:", exc, file=sys.stderr)
        raise
